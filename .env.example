# Badge Journey env vars

# Copy this file to `.env.local` and fill in values as needed.

# --- Solana badge minting (devnet, Metaplex Bubblegum cNFTs) ---
# Run: npm run setup:badge-tree
# Then paste the printed values here (and into Vercel for demos).

BADGE_MINTER_SECRET=
BADGE_TREE=
SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_DEMO_OWNER=
# Public origin used in NFT metadata URIs (must be reachable by explorers).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Swig smart wallet (parent mint destination) ---
# No extra API keys for the protocol SDK path used here.
# BADGE_MINTER_SECRET pays Swig create rent/fees; the parent authority
# keypair lives in the browser (localStorage) for this demo.
# Create/reconnect via the badge detail "Create Swig wallet" button.
# Docs: https://build.onswig.com/tutorials/typescript/create

# --- Optional later: Supabase auth ---
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
