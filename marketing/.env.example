# Veya marketing site — Stripe Founding Family ($1 once)

# Get keys from https://dashboard.stripe.com/apikeys
# Use test keys (sk_test_… / pk_test_…) until you are ready to take live payments.

STRIPE_SECRET_KEY=sk_test_replace_me
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# Public site origin used in Checkout success/cancel URLs.
# Local: http://127.0.0.1:3001
# Production: https://your-domain.com
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3001

# Optional later: webhook signing secret from Stripe CLI or Dashboard
# STRIPE_WEBHOOK_SECRET=whsec_replace_me
